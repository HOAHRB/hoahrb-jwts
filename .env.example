# Temporary Cookie copied from an authenticated local HIT teaching-system session.
HIT_JW_COOKIE="JSESSIONID=replace_me"
# Optional Cookie belonging to the HTTPS school identity provider, not the teaching site.
HIT_JW_CAS_COOKIE=""
HIT_JW_BASE_URL=http://jwts.hit.edu.cn

# Required when the teaching system is reachable only through a local proxy.
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897

HIT_JW_TIMEOUT_SECONDS=20
HIT_JW_DELAY_SECONDS=0.1
HIT_JW_MAX_RETRIES=3
